<https://w3id.org/cocos/model/base_bakta_50>
    a schema:SoftwareApplication ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    schema:identifier "base_bakta_50" ;
    schema:name "base_bakta_50" ;
    schema:description "Predicts antibiotic resistance from the presence or absence, in the isolate genome, of genes belonging to UniRef50 clusters."@en ;
    schema:url <https://github.com/mquirosq/cocos/tree/main/app/ai_models/base_bakta_50> ;
    schema:softwareVersion "1.0.0" ;
    schema:author <https://orcid.org/0000-0003-1685-3270> ;
    schema:featureList edam:operation_3482 ;
    schema:isBasedOn <https://www.ebi.ac.uk/biostudies/studies/S-BSST2698> ;
    bsc:input <https://w3id.org/cocos/model/base_bakta_50#genes> ;
    bsc:output <https://w3id.org/cocos/model/base_bakta_50#predictions> ;
    schema:taxonomicRange obo:NCBITaxon_2 ;
    amrf:predictsResistanceTo obo:ARO_0000013 ,   # amikacin
                              obo:ARO_3000645 ,   # cefotaxime
                              obo:ARO_0000073 .   # meropenem

<https://w3id.org/cocos/model/base_bakta_50#genes>
    a bioschemas:FormalParameter ;
    dcterms:conformsTo <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
    schema:name "genes" ;
    schema:additionalType edam:data_0916 ;
    schema:encodingFormat edam:format_3464 .

<https://w3id.org/cocos/model/base_bakta_50#predictions>
    a bioschemas:FormalParameter ;
    dcterms:conformsTo <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
    schema:name "predictions" ;
    schema:additionalType edam:data_2048 ;
    schema:encodingFormat edam:format_3752 .

