@prefix amrf:       <https://w3id.org/amrf/> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix bsc:        <https://bioschemas.org/properties/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix edam:       <http://edamontology.org/> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:     <https://schema.org/> .

# TODO: add schema:citation once the paper describing the models is accepted.

<https://w3id.org/cocos/model/base_bakta_50>
    a schema:SoftwareApplication ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    schema:identifier "base_bakta_50" ;
    schema:name "base_bakta_50" ;
    schema:description "Predicts antibiotic resistance from the presence or absence, in the isolate genome, of genes belonging to UniRef50 clusters."@en ;
    schema:url <https://github.com/mquirosq/cocos/tree/main/app/ai_models/base_bakta_50> ;
    schema:softwareVersion "1.0.0" ;
    schema:author <https://orcid.org/0000-0003-1685-3270> ;
    schema:featureList edam:operation_3482 ;
    schema:isBasedOn <https://www.ebi.ac.uk/biostudies/studies/S-BSST2698> ;
    bsc:input <https://w3id.org/cocos/model/base_bakta_50#genes> ;
    bsc:output <https://w3id.org/cocos/model/base_bakta_50#predictions> ;
    schema:taxonomicRange obo:NCBITaxon_2 ;
    amrf:predictsResistanceTo obo:ARO_0000013 ,   # amikacin
                              obo:ARO_3000645 ,   # cefotaxime
                              obo:ARO_0000073 .   # meropenem

<https://w3id.org/cocos/model/base_bakta_50#genes>
    a bioschemas:FormalParameter ;
    dcterms:conformsTo <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
    schema:name "genes" ;
    schema:additionalType edam:data_0916 .  # the genes Cocos extracted and keeps in its database

<https://w3id.org/cocos/model/base_bakta_50#predictions>
    a bioschemas:FormalParameter ;
    dcterms:conformsTo <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
    schema:name "predictions" ;
    schema:additionalType edam:data_2048 ;
    schema:encodingFormat edam:format_3752 .

<https://orcid.org/0000-0003-1685-3270>
    a schema:Person ;
    schema:name "Fernando Sola" .

# How the model was built (PROV-O): from the BAKTA50 feature matrix of the NDARO isolates
# (BioStudies S-BSST2698, Sola et al.), whose genomes were annotated with Bakta 1.9.4 and its full
# database. It follows the pattern of the provenance of a sample, so that both can be compared.
# The paper does not give the version of the Bakta database, so it is not stated.

<https://w3id.org/cocos/model/base_bakta_50>
    prov:wasDerivedFrom <https://w3id.org/cocos/model/base_bakta_50#training-data> .

<https://w3id.org/cocos/model/base_bakta_50#training-data>
    a prov:Entity ;
    schema:name "BAKTA50 feature matrix of the NDARO isolates"@en ;
    schema:description "Presence or absence, in the isolates of NCBI NDARO exported in January 2025, of the 20,407 UniRef50 clusters that Bakta found in at least 500 isolates, with their antimicrobial susceptibility."@en ;
    schema:isPartOf <https://doi.org/10.6019/S-BSST2698> ;
    schema:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    prov:wasGeneratedBy <https://w3id.org/cocos/model/base_bakta_50#annotation> .

<https://w3id.org/cocos/model/base_bakta_50#annotation>
    a prov:Activity ;
    rdfs:label "Annotation of the genomes of the training data"@en ;
    prov:wasAssociatedWith <https://w3id.org/cocos/model/base_bakta_50#bakta> ;
    prov:used <https://w3id.org/cocos/model/base_bakta_50#bakta-database> .

<https://w3id.org/cocos/model/base_bakta_50#bakta>
    a prov:SoftwareAgent ;
    rdfs:label "Bakta 1.9.4" ;
    schema:name "Bakta" ;
    schema:softwareVersion "1.9.4" ;
    prov:specializationOf <https://bio.tools/bakta> .

<https://w3id.org/cocos/model/base_bakta_50#bakta-database>
    a prov:Entity ;
    rdfs:label "Bakta database (full)" ;
    schema:name "Bakta database" .

# The files the model depends on: its weights for each antibiotic, with their SHA-256. Cocos does not
# register the model if one is missing or is not this file.

<https://w3id.org/cocos/model/base_bakta_50>
    schema:hasPart <https://w3id.org/cocos/model/base_bakta_50#weights-amikacin> , <https://w3id.org/cocos/model/base_bakta_50#weights-cefotaxime> , <https://w3id.org/cocos/model/base_bakta_50#weights-meropenem> .

<https://w3id.org/cocos/model/base_bakta_50#weights-amikacin>
    a schema:MediaObject ;
    schema:name "weights/amikacin.pt" ;
    schema:sha256 "6d9d0bbd65656b7145d4d5e71205a09152bec907cc12502ff7548d1a512b67a9" ;
    obo:IAO_0000136 obo:ARO_0000013 .

<https://w3id.org/cocos/model/base_bakta_50#weights-cefotaxime>
    a schema:MediaObject ;
    schema:name "weights/cefotaxime.pt" ;
    schema:sha256 "37b87b6efdb51937f5a2a435d56671abb433b31130b5f2529441eb7f824d6dcd" ;
    obo:IAO_0000136 obo:ARO_3000645 .

<https://w3id.org/cocos/model/base_bakta_50#weights-meropenem>
    a schema:MediaObject ;
    schema:name "weights/meropenem.pt" ;
    schema:sha256 "4bb42a660d0ceed73d64615ac4e0753c9187fc2b71327ec5b5b82564fa916067" ;
    obo:IAO_0000136 obo:ARO_0000073 .
