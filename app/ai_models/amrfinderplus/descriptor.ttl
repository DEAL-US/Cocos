@prefix amrf:       <https://w3id.org/amrf/> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix bsc:        <https://bioschemas.org/properties/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix edam:       <http://edamontology.org/> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix schema:     <https://schema.org/> .

# AMRFinderPlus (NCBI) with its hits interpreted by AMRrules (AMRverse), run in the model service of
# Cocos (tools/amrfinderplus of Cocos-deployment). It has no code here: it runs where its
# schema:potentialAction says.
#
# The antibiotics are those AMRFinderPlus names in its subclasses (through the table of AMRrules of
# subclasses to ARO) and some common ones of its classes (cefotaxime, ceftriaxone, ceftazidime,
# cefepime, cefoxitin, ertapenem, piperacillin, amoxicillin, ciprofloxacin, levofloxacin), whose
# verdicts come from what it says about their class. The beta-lactamase inhibitors it names alone
# (tazobactam, avibactam, vaborbactam, xeruborbactam, taniborbactam) are not antibiotics in ARO, so
# only their combinations are here.

<https://w3id.org/cocos/model/amrfinderplus>
    a schema:SoftwareApplication ;
    dcterms:conformsTo <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
    schema:identifier "amrfinderplus" ;
    schema:name "AMRFinderPlus" ;
    schema:description "Finds known antimicrobial resistance genes and point mutations in an assembly with NCBI AMRFinderPlus, and interprets them for each antibiotic with the expert rules of AMRrules for the organisms it has rules for; elsewhere, a gene of a class of antibiotics is a possible resistance to them."@en ;
    schema:url <https://github.com/ncbi/amr> ;
    schema:softwareVersion "4.2.7" ;
    schema:author <https://ror.org/02meqm098> ;
    schema:license <https://www.ncbi.nlm.nih.gov/home/about/policies/#copyright> ;
    schema:citation <https://doi.org/10.1038/s41598-021-91456-0> ;
    schema:featureList edam:operation_3482 ;
    bsc:input <https://w3id.org/cocos/model/amrfinderplus#assembly> ;
    bsc:output <https://w3id.org/cocos/model/amrfinderplus#predictions> , <https://w3id.org/cocos/model/amrfinderplus#tool_output> ;
    schema:taxonomicRange obo:NCBITaxon_2 ;
    schema:potentialAction [
        a schema:Action ;
        schema:target [ a schema:EntryPoint ;
                        schema:urlTemplate "predict/amrfinderplus" ;
                        schema:httpMethod "POST" ;
                        schema:contentType "multipart/form-data" ] ] ;
    amrf:predictsResistanceTo
