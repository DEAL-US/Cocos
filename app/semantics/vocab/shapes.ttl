@prefix amrf:       <https://w3id.org/amrf/> .
@prefix amrfsh:     <https://w3id.org/amrf/shapes#> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix bsc:        <https://bioschemas.org/properties/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix dqv:        <http://www.w3.org/ns/dqv#> .
@prefix edam:       <http://edamontology.org/> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix p-plan:     <http://purl.org/net/p-plan#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:     <https://schema.org/> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

# What a valid description of an antimicrobial resistance prediction model, and of the steps that
# prepare its inputs, looks like. Checking that a term "is an antibiotic" or "is an EDAM format"
# follows rdfs:subClassOf up to the root, so the hierarchy of the reused terms must be in the data
# graph (Cocos adds terms.ttl).

amrfsh:
    a owl:Ontology ;
    dcterms:title "AMRF shapes: validation of antimicrobial resistance model descriptions"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-16"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    rdfs:seeAlso amrf: .

# --- Tools: every step and model (Bioschemas ComputationalTool 1.0 minimum, plus EDAM I/O)

amrfsh:ToolShape
    a sh:NodeShape ;
    sh:targetClass schema:SoftwareApplication ;
    sh:property [
        sh:path schema:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A tool needs exactly one schema:identifier."@en ;
    ] , [
        sh:path schema:name ; sh:minCount 1 ;
        sh:message "A tool needs a schema:name (Bioschemas minimum)."@en ;
    ] , [
        sh:path schema:description ; sh:minCount 1 ; sh:minLength 1 ;
        sh:message "A tool needs a schema:description (Bioschemas minimum)."@en ;
    ] , [
        sh:path schema:url ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A tool needs a schema:url, the web page of the tool (Bioschemas minimum)."@en ;
    ] , [
        sh:path dcterms:conformsTo ;
        sh:hasValue <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
        sh:message "A tool must declare dcterms:conformsTo the Bioschemas ComputationalTool 1.0 profile."@en ;
    ] , [
        sh:path schema:featureList ; sh:minCount 1 ; sh:node amrfsh:EdamOperation ;
        sh:message "A tool needs at least one schema:featureList, and each must be an EDAM operation."@en ;
    ] , [
        sh:path bsc:input ; sh:minCount 1 ; sh:class bioschemas:FormalParameter ;
        sh:message "A tool needs at least one bsc:input, and each must be a bioschemas:FormalParameter."@en ;
    ] , [
        sh:path bsc:output ; sh:minCount 1 ; sh:class bioschemas:FormalParameter ;
        sh:message "A tool needs at least one bsc:output, and each must be a bioschemas:FormalParameter."@en ;
    ] .

# --- Inputs and outputs (Bioschemas FormalParameter 1.0, with EDAM data and format)

amrfsh:ParameterShape
    a sh:NodeShape ;
    sh:targetObjectsOf bsc:input , bsc:output ;
    sh:property [
        sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A parameter needs exactly one schema:name, its role."@en ;
    ] , [
        sh:path dcterms:conformsTo ;
        sh:hasValue <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
        sh:message "A parameter must declare dcterms:conformsTo the Bioschemas FormalParameter 1.0 profile."@en ;
    ] , [
        sh:path schema:additionalType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node amrfsh:EdamData ;
        sh:message "A parameter needs exactly one schema:additionalType, an EDAM data term."@en ;
    ] , [
        sh:path schema:encodingFormat ; sh:maxCount 1 ; sh:node amrfsh:EdamFormat ;
        sh:message "A parameter has at most one schema:encodingFormat, an EDAM format term."@en ;
    ] ;
    # Every parameter is a file with a format, except the genes (EDAM Gene report), which Cocos
    # keeps in its database, linked to the annotation they come from.
    sh:or (
        [ sh:path schema:encodingFormat ; sh:minCount 1 ]
        [ sh:path schema:additionalType ; sh:hasValue edam:data_0916 ]
    ) ;
    sh:message "A parameter needs a schema:encodingFormat, unless it is a Gene report (edam:data_0916)."@en .

# --- Models: tools that perform EDAM Antimicrobial resistance prediction

amrfsh:ModelShape
    a sh:NodeShape ;
    # A SPARQL target (SHACL Advanced Features) selects the tools that are models.
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this <https://schema.org/featureList> <http://edamontology.org/operation_3482> . }
        """ ;
    ] ;
    # The properties are on this shape (not behind sh:node) so that a missing recommended
    # property is a warning, not a failure of the whole model.
    sh:property [
        sh:path schema:softwareVersion ; sh:minCount 1 ;
        sh:message "A model needs a schema:softwareVersion."@en ;
    ] , [
        sh:path amrf:predictsResistanceTo ; sh:minCount 1 ; sh:node amrfsh:Antibiotic ;
        sh:message "A model needs at least one amrf:predictsResistanceTo, and each must be an ARO antibiotic."@en ;
    ] , [
        sh:path schema:taxonomicRange ; sh:minCount 1 ; sh:node amrfsh:Taxon ;
        sh:message "A model needs at least one schema:taxonomicRange, and each must be an NCBITaxon term (NCBITaxon_2, Bacteria, for any organism)."@en ;
    ] , [
        sh:path schema:author ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A model should declare its schema:author."@en ;
    ] , [
        sh:path schema:license ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A model should declare its schema:license."@en ;
    ] , [
        sh:path schema:citation ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A model should declare how to cite it (schema:citation)."@en ;
    ] .

# --- Reused terms: each must sit under the root of its ontology

amrfsh:EdamOperation
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue edam:operation_0004 ;
        sh:message "Not an EDAM operation (or not in terms.ttl: run manage.py fetch_terms)."@en ;
    ] .

amrfsh:EdamData
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue edam:data_0006 ;
        sh:message "Not an EDAM data term (or not in terms.ttl: run manage.py fetch_terms)."@en ;
    ] .

amrfsh:EdamFormat
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue edam:format_1915 ;
        sh:message "Not an EDAM format (or not in terms.ttl: run manage.py fetch_terms)."@en ;
    ] .

amrfsh:Antibiotic
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue obo:ARO_1000003 ;
        sh:message "Not an ARO antibiotic molecule (or not in terms.ttl: run manage.py fetch_terms)."@en ;
    ] .

amrfsh:Taxon
    a sh:NodeShape ;
    sh:property [
        sh:path [ sh:zeroOrMorePath rdfs:subClassOf ] ; sh:hasValue obo:NCBITaxon_1 ;
        sh:message "Not an NCBITaxon organism (or not in terms.ttl: run manage.py fetch_terms)."@en ;
    ] .

# --- The AMRF vocabulary itself: every own term documented and justified

amrfsh:OwnTermShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this ?p ?o .
                FILTER (isIRI(?this) && STRSTARTS(STR(?this), "https://w3id.org/amrf/")
                        && !STRSTARTS(STR(?this), "https://w3id.org/amrf/shapes")
                        && ?this != <https://w3id.org/amrf/>)
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ;
        sh:message "An AMRF term needs an rdfs:label."@en ;
    ] , [
        sh:path rdfs:comment ; sh:minCount 1 ;
        sh:message "An AMRF term needs an rdfs:comment that defines it."@en ;
    ] , [
        sh:path skos:editorialNote ; sh:minCount 1 ;
        sh:message "An AMRF term needs a skos:editorialNote explaining why no existing term fits."@en ;
    ] , [
        sh:path rdfs:isDefinedBy ; sh:hasValue amrf: ;
        sh:message "An AMRF term needs rdfs:isDefinedBy amrf:."@en ;
    ] .

# --- Samples: the data a framework holds about one isolate (instance data, not the registry)

amrfsh:SampleShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:identifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A sample needs exactly one schema:identifier."@en ;
    ] , [
        sh:path schema:name ; sh:minCount 1 ;
        sh:message "A sample needs a schema:name."@en ;
    ] , [
        sh:path schema:taxonomicRange ; sh:node amrfsh:Taxon ;
        sh:message "The organism of a sample (schema:taxonomicRange) must be an NCBITaxon term; leave it out if unknown."@en ;
    ] , [
        sh:path schema:hasPart ; sh:class schema:DataDownload ;
        sh:message "The parts of a sample (schema:hasPart) must be schema:DataDownload entries."@en ;
    ] .

amrfsh:DataEntryShape
    a sh:NodeShape ;
    sh:targetClass schema:DataDownload ;
    sh:property [
        sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A piece of data needs exactly one schema:name, its role."@en ;
    ] , [
        sh:path schema:additionalType ; sh:minCount 1 ; sh:maxCount 1 ; sh:node amrfsh:EdamData ;
        sh:message "A piece of data needs exactly one schema:additionalType, an EDAM data term."@en ;
    ] , [
        sh:path schema:encodingFormat ; sh:maxCount 1 ; sh:node amrfsh:EdamFormat ;
        sh:message "A piece of data has at most one schema:encodingFormat, an EDAM format term."@en ;
    ] , [
        sh:path schema:sha256 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "The checksum of a file (schema:sha256) is one SHA-256: 64 lowercase hexadecimal digits."@en ;
    ] ;
    # As for parameters: every piece of data is a file with a format, except the genes.
    sh:or (
        [ sh:path schema:encodingFormat ; sh:minCount 1 ]
        [ sh:path schema:additionalType ; sh:hasValue edam:data_0916 ]
    ) ;
    sh:message "A piece of data needs a schema:encodingFormat, unless it is a Gene report (edam:data_0916)."@en .

# --- Provenance of a sample (PROV-O and P-Plan; see semantics.provenance)

# The tasks of Cocos: activities with a status. Other activities (e.g. how the training data of a
# model was annotated, in its descriptor) only need what PROV-O itself says.
amrfsh:ActivityShape
    a sh:NodeShape ;
    sh:targetSubjectsOf schema:actionStatus ;
    sh:property [
        sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An activity needs exactly one schema:name, the step it ran."@en ;
    ] , [
        sh:path schema:actionStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( schema:PotentialActionStatus schema:ActiveActionStatus schema:CompletedActionStatus schema:FailedActionStatus ) ;
        sh:message "An activity needs exactly one schema:actionStatus: potential, active, completed or failed."@en ;
    ] , [
        sh:path prov:startedAtTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "An activity starts at most once (prov:startedAtTime, an xsd:dateTime)."@en ;
    ] , [
        sh:path prov:endedAtTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "An activity ends at most once (prov:endedAtTime, an xsd:dateTime)."@en ;
    ] , [
        sh:path prov:wasAssociatedWith ; sh:minCount 1 ;
        sh:message "An activity needs an agent (prov:wasAssociatedWith): at least the step of the registry it ran."@en ;
    ] ;
    # An activity that finished, well or not, says when and with which software.
    sh:or (
        [ sh:path schema:actionStatus ; sh:in ( schema:PotentialActionStatus schema:ActiveActionStatus ) ]
        [
            sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ] ;
            sh:property [
                sh:path prov:wasAssociatedWith ;
                sh:qualifiedValueShape [ sh:class prov:SoftwareAgent ] ; sh:qualifiedMinCount 1 ;
            ] ;
        ]
    ) ;
    sh:message "A finished activity needs prov:endedAtTime and a prov:SoftwareAgent (at least Cocos)."@en .

amrfsh:SoftwareAgentShape
    a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A piece of software needs exactly one schema:name."@en ;
    ] , [
        sh:path schema:softwareVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
        sh:message "A piece of software needs exactly one schema:softwareVersion."@en ;
    ] .

amrfsh:PlanStepShape
    a sh:NodeShape ;
    sh:targetClass p-plan:Step ;
    sh:property [
        sh:path p-plan:isStepOfPlan ; sh:minCount 1 ; sh:maxCount 1 ; sh:class p-plan:Plan ;
        sh:message "A step of a plan belongs to exactly one p-plan:Plan."@en ;
    ] .

# --- Quality of a plug-in (DQV, in its quality.ttl): optional, for any kind of model or step

amrfsh:QualityMeasurementShape
    a sh:NodeShape ;
    sh:targetClass dqv:QualityMeasurement ;
    sh:targetObjectsOf dqv:hasQualityMeasurement ;
    sh:property [
        sh:path dqv:isMeasurementOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A measurement is of exactly one metric (dqv:isMeasurementOf), a term such as STATO F1 score."@en ;
    ] , [
        sh:path dqv:value ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] [ sh:datatype xsd:double ] ) ;
        sh:message "A measurement has exactly one numeric dqv:value."@en ;
    ] , [
        sh:path dqv:computedOn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A measurement says on which data it was computed (dqv:computedOn): training, validation..."@en ;
    ] , [
        sh:path obo:IAO_0000136 ; sh:nodeKind sh:IRI ;
        sh:message "What a measurement is about (obo:IAO_0000136, e.g. an antibiotic of ARO or an organism of NCBITaxon) are terms."@en ;
    ] .

# --- Files a plug-in depends on (schema:hasPart of a model: e.g. its weights), optional

amrfsh:PluginFileShape
    a sh:NodeShape ;
    sh:targetClass schema:MediaObject ;
    sh:property [
        sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A file of a plug-in needs exactly one schema:name, its path in the folder of the plug-in."@en ;
    ] , [
        sh:path schema:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "A file of a plug-in needs exactly one schema:sha256: 64 lowercase hexadecimal digits."@en ;
    ] .
