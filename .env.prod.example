# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERATE_WITH_django_shell_get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

COMPOSE_PROJECT_NAME=cocos

# PostgreSQL
POSTGRES_DB=cocos
POSTGRES_USER=cocos_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE

DB_NAME=cocos
DB_USER=cocos_user
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_HOST=cocos-postgres
DB_PORT=5432
DB_CONN_MAX_AGE=300

# Redis / Celery
CELERY_BROKER_URL=redis://cocos-redis:6379/0

# Annotation service
ANNOTATION_BASE=http://bio-assembly-api:8000

# Email / SendGrid
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
NOTIFICATION_EMAIL_SUBJECT=Cocos Notification
SENDGRID_API_KEY=sg_live_YOUR_KEY_HERE
