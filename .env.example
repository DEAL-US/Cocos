DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret
COMPOSE_PROJECT_NAME=cocos

POSTGRES_DB=cocos
POSTGRES_USER=cocos
POSTGRES_PASSWORD=cocos_database_password

DB_NAME=cocos
DB_USER=cocos
DB_PASSWORD=cocos_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://cocos-dev-redis:6379/0

ANNOTATION_BASE=http://bio-assembly-api:8000
MODEL_SERVICE_BASE=http://model-api:8000
MOCK_ANNOTATION_BASE=http://mock-bio-service:8000

MOCK=true

# Optional: in development emails are printed to the console
# DEFAULT_FROM_EMAIL=noreply@cocos.com
# NOTIFICATION_EMAIL_SUBJECT=Cocos Notification

# Optional: web page of the source code, which the RDF descriptions of the steps link to
# COCOS_SOURCE_URL=https://github.com/DEAL-US/Cocos/blob/main